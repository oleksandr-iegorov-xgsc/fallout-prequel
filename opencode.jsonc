// Local vLLM variant. Copy over opencode.json, or merge the "agent"
// block in.
//
//   vllm serve <big>   --served-model-name builder-128k \
//                      --max-model-len 131072 --port 8000
//   vllm serve <small> --served-model-name qwen3.6-27b-awq-int4 \
//                      --max-model-len 65536  --port 8000
//
// Context window comes from the SERVED MODEL, not from this file.
// The "limit" block only tells opencode how much room it has left.
{
  "$schema": "https://opencode.ai/config.json",

  "model": "vllm/qwen3.6-27b-awq-int4",

  "instructions": ["AGENTS.md", "SOUL.md"],

  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "{file:~/.secrets/vllm-key}"
      },
      "models": {
        "qwen3.6-27b-awq-int4": {
          "name": "Qwen3.6 27B AWQ - 131K"
        }
      }
    }
  },

  // Builder is the only role whose context does real work. Everything
  // else runs happily at 64K.
  "agent": {
    "builder":    { "model": "vllm/qwen3.6-27b-awq-int4" },
    "reviewer":   { "model": "vllm/qwen3.6-27b-awq-int4" },
    "playtester": { "model": "vllm/qwen3.6-27b-awq-int4" },
    "planner":    { "model": "vllm/qwen3.6-27b-awq-int4" },
    "ideator":    { "model": "vllm/qwen3.6-27b-awq-int4" },
    "build": { "disable": true },
    "plan":  { "disable": true }
  }
}
